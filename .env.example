# Copy to .env for local development. On Vercel, set these in
# Project Settings -> Environment Variables (Production + Preview).

# MongoDB Atlas connection string
MONGO_URI=

# Secret used to sign JWTs
JWT_SECRET=

# Local API port (matches the CRA "proxy" field in frontend/package.json).
# Not used on Vercel.
PORT=8000

NODE_ENV=development

# PayPal REST app client id (sandbox or live)
PAYPAL_CLIENT_ID=

# SendGrid API key, used as the SMTP password. Leave blank to disable
# transactional email - the app logs a warning and carries on.
MAILER_API_KEY=
MAIL_FROM=

# Injected automatically by Vercel once a Blob store is connected to the
# project. Needed locally only if you want to test /api/upload.
BLOB_READ_WRITE_TOKEN=
